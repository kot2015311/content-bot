# Скопируй этот файл в .env и заполни. Файл .env никому не показывай и не заливай на GitHub.

# ===== Обязательно =====
# Токен бота от @BotFather
BOT_TOKEN=
# Твой Telegram id (узнать у @userinfobot). Только ты сможешь пользоваться ботом
OWNER_ID=
# Канал, куда публиковать: @username_канала (бот должен быть в нём админом)
CHANNEL_ID=

# ===== Нейросеть (заполни ОДИН вариант или ни одного) =====
# Если ничего не заполнить, бот работает без нейросети: публикует твои готовые тексты и монтирует видео.
# Можно указать явно: LLM_PROVIDER=gigachat / openai / claude / none
LLM_PROVIDER=

# Вариант 1. GigaChat (Сбер): бесплатный лимит для физлиц, работает без VPN.
# Ключ: developers.sber.ru -> GigaChat API -> «Ключ авторизации» (длинная строка, кончается на ==)
GIGACHAT_CREDENTIALS=
# Модель: GigaChat-2 (бесплатная), GigaChat-2-Pro, GigaChat-2-Max. Если указанной нет, бот выберет сам
GIGACHAT_MODEL=GigaChat-2

# Вариант 2. OpenRouter: есть бесплатные модели (в названии :free). Ключ: openrouter.ai/keys
# Модель выбери на openrouter.ai/models, фильтр Prompt pricing = FREE, и скопируй её id
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Вариант 3. Claude API (платно, нужна зарубежная карта и VPN)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low

# ===== Монтаж =====
# Модель распознавания речи: tiny / base / small / medium. Если монтаж долгий, поставь base
WHISPER_MODEL=small
# 1 — вшивать субтитры, 0 — нет
SUBTITLES=1
# 1 — вырезать паузы, 0 — нет
CUT_PAUSES=1
